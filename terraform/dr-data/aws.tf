resource "aws_db_subnet_group" "primary" {
  name       = var.rds_identifier
  subnet_ids = sort(data.aws_subnets.private.ids)

  tags = {
    Name = var.rds_identifier
  }
}

resource "aws_security_group" "rds" {
  name        = var.rds_identifier
  description = "Private PostgreSQL access from EKS and the Cloud SQL service range over VPN"
  vpc_id      = data.aws_vpc.primary.id

  tags = {
    Name = var.rds_identifier
  }
}

resource "aws_vpc_security_group_ingress_rule" "rds_from_eks" {
  security_group_id            = aws_security_group.rds.id
  referenced_security_group_id = data.aws_security_group.eks_nodes.id
  description                  = "Bank of Anthos workloads and bootstrap jobs in EKS"
  from_port                    = 5432
  to_port                      = 5432
  ip_protocol                  = "tcp"
}

resource "aws_vpc_security_group_ingress_rule" "rds_from_cloudsql" {
  security_group_id = aws_security_group.rds.id
  cidr_ipv4         = local.cloudsql_private_service_cidr
  description       = "Cloud SQL and Database Migration Service over HA VPN"
  from_port         = 5432
  to_port           = 5432
  ip_protocol       = "tcp"
}

resource "aws_db_parameter_group" "dms" {
  name   = "${var.rds_identifier}16-dms"
  family = "postgres16"

  parameter {
    name         = "shared_preload_libraries"
    value        = "pglogical"
    apply_method = "pending-reboot"
  }

  parameter {
    name         = "rds.logical_replication"
    value        = "1"
    apply_method = "pending-reboot"
  }

  parameter {
    name         = "wal_sender_timeout"
    value        = "0"
    apply_method = "immediate"
  }

  parameter {
    name         = "max_replication_slots"
    value        = "10"
    apply_method = "pending-reboot"
  }

  parameter {
    name         = "max_wal_senders"
    value        = "12"
    apply_method = "pending-reboot"
  }

  parameter {
    name         = "max_worker_processes"
    value        = "12"
    apply_method = "pending-reboot"
  }
}

resource "aws_db_instance" "primary" {
  identifier = var.rds_identifier

  engine               = "postgres"
  engine_version       = var.rds_engine_version
  instance_class       = var.rds_instance_class
  parameter_group_name = aws_db_parameter_group.dms.name

  username                    = "bankadmin"
  manage_master_user_password = true
  port                        = 5432

  allocated_storage     = 20
  max_allocated_storage = 100
  storage_type          = "gp3"
  storage_encrypted     = true

  multi_az               = true
  publicly_accessible    = false
  db_subnet_group_name   = aws_db_subnet_group.primary.name
  vpc_security_group_ids = [aws_security_group.rds.id]

  backup_retention_period    = 1
  copy_tags_to_snapshot      = true
  auto_minor_version_upgrade = false
  apply_immediately          = true

  deletion_protection = false
  skip_final_snapshot = true

  lifecycle {
    precondition {
      condition     = data.aws_caller_identity.current.account_id == var.aws_account_id
      error_message = "Refusing to create RDS outside the approved kdn10 AWS account."
    }

    precondition {
      condition     = length(data.aws_subnets.private.ids) == 2
      error_message = "Exactly two existing private subnets are required for the Phase 1 two-AZ design."
    }
  }

  tags = {
    Name = var.rds_identifier
  }
}

resource "aws_secretsmanager_secret" "app_database" {
  name                    = "${var.database_secret_prefix}/app"
  description             = "Accounts and ledger application credentials generated by the approved DB bootstrap workflow"
  recovery_window_in_days = 0
}

resource "aws_secretsmanager_secret" "dms_source" {
  name                    = "${var.database_secret_prefix}/dms"
  description             = "Least-privilege PostgreSQL source credentials for Google Database Migration Service"
  recovery_window_in_days = 0
}
